<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:G2P"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="680"
        Width="900" Height="680"
        x:Class="G2P.MainWindow"
        Title="G2P Neural Model Tester"
        WindowStartupLocation="CenterScreen"
        Background="#F5EFD4">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FDFBF2"/>
            <Setter Property="Foreground" Value="#804D1C"/>
            <Setter Property="BorderBrush" Value="#E6847C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FDFBF2"/>
            <Setter Property="Foreground" Value="#804D1C"/>
            <Setter Property="BorderBrush" Value="#E6847C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#804D1C"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="20">
        
        <!-- Config File Picker Toolbar -->
        <Border Grid.Row="0" Background="#E3DBBA" BorderBrush="#E6847C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Configuration File" FontWeight="Bold" Foreground="#B2742E" FontSize="11"/>
                    <TextBlock x:Name="ConfigPathLabel" Text="config.yaml" Foreground="#804D1C" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse Config..." Click="OnBrowseConfigClicked" 
                        Background="#FF938A" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="12,8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Model Selector & Architecture Badge -->
        <Border Grid.Row="1" Background="#E3DBBA" BorderBrush="#E6847C" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel Spacing="6">
                <TextBlock Text="Select G2P Model" FontWeight="Bold" Foreground="#804D1C" FontSize="13"/>
                <Grid ColumnDefinitions="*, Auto">
                    <ComboBox x:Name="ModelComboBox" 
                              Grid.Column="0"
                              HorizontalAlignment="Stretch" 
                              SelectionChanged="OnModelSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ModelConfig">
                                <TextBlock Text="{Binding model_name}" Foreground="#804D1C" FontWeight="Medium"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Grid.Column="1" 
                            Margin="12,0,0,0" 
                            Padding="12,6" 
                            VerticalAlignment="Center" 
                            CornerRadius="6" 
                            x:Name="ModelTypeBadge" 
                            Background="#E2DAC3">
                        <TextBlock x:Name="ModelTypeLabel" 
                                   Text="No Model Loaded" 
                                   Foreground="#804D1C" 
                                   FontWeight="Bold" 
                                   FontSize="12"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Input Section -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,15">
            <TextBlock Text="Input Grapheme / Text" Foreground="#804D1C" FontWeight="Bold" FontSize="13"/>
            <TextBox x:Name="GraphemeInput" 
                     Watermark="Enter grapheme or sentence..." 
                     FontSize="14" 
                     TextChanged="OnInputTextChanged"/>
            <StackPanel Orientation="Horizontal" Spacing="20">
                <CheckBox x:Name="SplitCharacterCheckBox" Content="Enable Split Character Processing" 
                          IsCheckedChanged="OnSplitCharacterToggled"/>
                <CheckBox x:Name="RemoveVowelStressCheckBox" Content="Remove Vowel Stress (e.g., ah1 → ah)" 
                          IsCheckedChanged="OnRemoveVowelStressToggled"/>
            </StackPanel>
        </StackPanel>

        <!-- Output Section -->
        <Grid Grid.Row="3" RowDefinitions="Auto, *">
            <TextBlock Grid.Row="0" Text="Phoneme Prediction (Click card to inspect variants, log-probabilities &amp; switch models)" Foreground="#804D1C" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
            
            <Grid Grid.Row="1" ColumnDefinitions="*, 230">
                
                <!-- Left: OpenUtau Note Boxes Container -->
                <Border Grid.Column="0" 
                        Background="#FDFBF2" 
                        BorderBrush="#25B19C" 
                        BorderThickness="1.5" 
                        CornerRadius="8" 
                        Padding="12" 
                        Margin="0,0,12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PhonemesItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:NoteBoxModel">
                                    <!-- Note Card: VerticalAlignment="Top" keeps all card headers baseline-aligned -->
                                    <Border Background="#F5EFD4" 
                                            BorderBrush="#E6847C" 
                                            BorderThickness="1.5" 
                                            CornerRadius="8" 
                                            Padding="10,8" 
                                            Margin="4"
                                            MaxWidth="600"
                                            VerticalAlignment="Top"
                                            PointerPressed="OnNoteBoxPointerPressed"
                                            Cursor="Hand">
                                        
                                        <!-- Avalonia 12 Attached Flyout Inspector -->
                                        <FlyoutBase.AttachedFlyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Transient">
                                                <Border Background="#FDFBF2" 
                                                        BorderBrush="#25B19C" 
                                                        BorderThickness="1.5" 
                                                        CornerRadius="10" 
                                                        Padding="14" 
                                                        Width="420" 
                                                        MaxHeight="450">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Spacing="10" Margin="0,0,4,0">
                                                            
                                                            <!-- Header Info -->
                                                            <Grid ColumnDefinitions="*, Auto">
                                                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Word, StringFormat='Word: {0}'}" 
                                                                            FontSize="14" 
                                                                            FontWeight="Bold" 
                                                                            Foreground="#804D1C" 
                                                                            TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding SourceModelInfo}" 
                                                                            FontSize="11" 
                                                                            Foreground="#B2742E" 
                                                                            FontWeight="SemiBold"
                                                                            TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="#25B19C" CornerRadius="6" Padding="8,4" VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding ConfidenceText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Model Switcher -->
                                                            <StackPanel Spacing="6" IsVisible="{Binding HasMergedModel}">
                                                                <Separator Height="1" Background="#E6847C"/>
                                                                <TextBlock Text="Model Switcher for this word:" FontSize="11" FontWeight="Bold" Foreground="#804D1C"/>
                                                                <Grid ColumnDefinitions="*, *">
                                                                    <Button Grid.Column="0" Content="Use Primary Model" Margin="0,0,3,0" Padding="6,6" 
                                                                            Background="#E3DBBA" Foreground="#804D1C" FontWeight="Bold" FontSize="11" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                            Click="OnSwitchToPrimaryModelClicked" Tag="{Binding}"/>
                                                                    <Button Grid.Column="1" Content="Use Merged Model" Margin="3,0,0,0" Padding="6,6" 
                                                                            Background="#FF938A" Foreground="White" FontWeight="Bold" FontSize="11" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                            Click="OnSwitchToMergedModelClicked" Tag="{Binding}"/>
                                                                </Grid>
                                                            </StackPanel>

                                                            <Separator Height="1" Background="#E6847C"/>

                                                            <!-- Pronunciation Variants -->
                                                            <StackPanel Spacing="6">
                                                                <TextBlock Text="Pronunciation Variants (Click to select):" FontSize="11" FontWeight="Bold" Foreground="#804D1C"/>
                                                                <ItemsControl ItemsSource="{Binding Alternatives}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="local:CandidateModel">
                                                                            <Button HorizontalAlignment="Stretch" Margin="0,2" Padding="8,6" 
                                                                                    Background="{Binding ButtonBackground}" 
                                                                                    BorderBrush="#E6847C" BorderThickness="1" CornerRadius="6"
                                                                                    Click="OnCandidateSelected" Tag="{Binding}">
                                                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                                                    <TextBlock Grid.Column="0" 
                                                                                            Text="{Binding VariantLabel}" 
                                                                                            FontSize="11" 
                                                                                            FontWeight="Bold" 
                                                                                            Foreground="#B2742E" 
                                                                                            VerticalAlignment="Center" 
                                                                                            Margin="0,0,8,0"
                                                                                            MaxWidth="95"
                                                                                            TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Grid.Column="1" 
                                                                                            Text="{Binding DisplayPhonemes}" 
                                                                                            FontFamily="Consolas, Monospace" 
                                                                                            FontWeight="Bold" 
                                                                                            FontSize="12"
                                                                                            Foreground="#804D1C" 
                                                                                            VerticalAlignment="Center"
                                                                                            TextWrapping="Wrap"
                                                                                            Margin="0,0,8,0"/>
                                                                                    <TextBlock Grid.Column="2" 
                                                                                            Text="{Binding ConfidenceText}" 
                                                                                            FontSize="11" 
                                                                                            Foreground="#209988" 
                                                                                            FontWeight="SemiBold" 
                                                                                            VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>

                                                            <Separator Height="1" Background="#E6847C"/>

                                                            <!-- Log-Probabilities Table -->
                                                            <StackPanel Spacing="6">
                                                                <TextBlock Text="Per-Phoneme Log-Probabilities:" FontSize="11" FontWeight="Bold" Foreground="#804D1C"/>
                                                                <Border Background="#FDFBF2" BorderBrush="#E6847C" BorderThickness="1" CornerRadius="6" Padding="6,4" MaxHeight="130">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                        <ItemsControl ItemsSource="{Binding LogProbs}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="local:TokenLogProbModel">
                                                                                    <Grid ColumnDefinitions="45, *, 55, 60" Margin="0,2">
                                                                                        <TextBlock Grid.Column="0" Text="{Binding Phoneme}" FontFamily="Consolas, Monospace" FontWeight="Bold" Foreground="{Binding TextColor}"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="10" Foreground="#804D1C" VerticalAlignment="Center"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding LogProbText}" FontSize="10" FontFamily="Consolas, Monospace" Foreground="#B2742E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                                        <TextBlock Grid.Column="3" Text="{Binding ConfidenceText}" FontSize="10" FontWeight="Bold" Foreground="#209988" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>
                                            </Flyout>
                                        </FlyoutBase.AttachedFlyout>

                                        <ToolTip.Tip>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Left-Click: Open Inspector &amp; Variant List" FontSize="10" Foreground="#209988"/>
                                                <TextBlock Text="Right-Click: Toggle Primary / Merged Model" FontSize="10" Foreground="#D9534F"/>
                                            </StackPanel>
                                        </ToolTip.Tip>

                                        <StackPanel Spacing="4">
                                            <!-- Card Header -->
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" 
                                                        Text="{Binding Word}" 
                                                        Foreground="#B2742E" 
                                                        FontSize="11" 
                                                        FontWeight="Bold" 
                                                        HorizontalAlignment="Left"
                                                        TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" 
                                                        Text="{Binding ModelTag}" 
                                                        Foreground="#804D1C" 
                                                        FontSize="9" 
                                                        FontWeight="SemiBold" 
                                                        Margin="6,0,0,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"/>
                                            </Grid>
                                            
                                            <!-- Wrapped Phonemes Sequence -->
                                            <ItemsControl ItemsSource="{Binding Phonemes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:PhonemeTextModel">
                                                        <TextBlock Text="{Binding Phoneme}" 
                                                                Foreground="{Binding Foreground}" 
                                                                FontWeight="Bold" 
                                                                FontSize="20" 
                                                                FontFamily="Consolas, Monospace"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,4,2">
                                                            <ToolTip.Tip>
                                                                <TextBlock Text="{Binding TypeName}"/>
                                                            </ToolTip.Tip>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Right: Phoneme Types Legend Box -->
                <Border Grid.Column="1" Background="#E3DBBA" BorderBrush="#E6847C" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="Phoneme Types" FontWeight="Bold" Foreground="#804D1C" FontSize="16" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PhonemeTypesLegendControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:PhonemeTypeLegendModel">
                                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,4">
                                            <Border Grid.Column="0" Width="14" Height="14" CornerRadius="4" Background="{Binding BadgeColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TypeName}" Foreground="#804D1C" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#B2742E" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- Footer / Status Bar -->
        <TextBlock Grid.Row="4" x:Name="StatusLog" Text="Ready" 
                   Foreground="#B2742E" FontSize="12" FontWeight="Medium" Margin="0,10,0,0"/>
    </Grid>
</Window>